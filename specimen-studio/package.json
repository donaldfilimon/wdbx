{
  "name": "wdbx-specimen-studio",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun --bun vinext build",
    "build:wasm": "cargo build --locked -p specimen-wasm --target wasm32-unknown-unknown --release",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "bun test",
    "test:browser": "bun tests/browser.e2e.mjs && bun tests/accessibility.e2e.mjs",
    "lint:studio": "oxlint app lib/specimen lib/webmcp.ts",
    "desktop:dev": "bun --bun vite --config vite.desktop.config.ts",
    "desktop:build": "bun --bun vite build --config vite.desktop.config.ts",
    "desktop": "tauri dev",
    "desktop:package": "bun --bun tauri build",
    "test:native": "cargo test --locked -p specimen-kernel -p specimen-core -p specimen-wasm",
    "check:native": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "sh scripts/check-instructions.sh && bunx tsc --noEmit && bun run lint:studio && bun run build:wasm && bun test && bun run build",
    "check:all": "bun run check && bun run check:native"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@shadcn/react": "0.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
