+// A connective runs before the negation pass. Reject any vocabulary in which it
+// can swallow even part of a negator (including a prefix/suffix across rows).
+// This deliberately conservative constructor admits no competing control roles.
+fn validate_controls(rows: &[UtilityRow], phrases: &[Vec<String>]) -> Result<(), LanguageError> {
+    let mut negation_words = BTreeSet::new();
+    for (row, words) in rows.iter().zip(phrases) {
+        if matches!(row.effect, UtilityEffect::Negation { .. }) {
+            for word in words {
+                if matches!(word.as_str(), "and" | "or" | "but" | "if" | "then") {
+                    return Err(LanguageError::InvalidTables);
+                }
+                negation_words.insert(word.as_str());
+            }
+        }
+    }
+    for (row, words) in rows.iter().zip(phrases) {
+        for word in words {
+            if matches!(word.as_str(), "if" | "then") {
+                let expected = if word == "if" {
+                    Connective::If
+                } else {
+                    Connective::Then
+                };
+                if words.len() != 1
+                    || !matches!(row.effect, UtilityEffect::Conjunction(c) if c == expected)
+                {
+                    return Err(LanguageError::InvalidTables);
+                }
+            }
+            if let UtilityEffect::Conjunction(c) = row.effect {
+                if is_negator(word) || negation_words.contains(word.as_str()) {
+                    return Err(LanguageError::InvalidTables);
+                }
+                let builtin = match word.as_str() {
+                    "and" => Some(Connective::And),
+                    "or" => Some(Connective::Or),
+                    "but" => Some(Connective::But),
+                    _ => None,
+                };
+                if builtin.is_some_and(|b| b != c) {
+                    return Err(LanguageError::InvalidTables);
+                }
+                // Conditional keywords have fixed positions and exact vocabulary.
+                if matches!(c, Connective::If | Connective::Then)
+                    && !(words.len() == 1 && matches!(word.as_str(), "if" | "then"))
+                {
+                    return Err(LanguageError::InvalidTables);
+                }
+            }
+        }
+    }
+    Ok(())
+}
