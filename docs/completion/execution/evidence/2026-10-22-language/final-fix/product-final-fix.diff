+// Preserve the complete antecedent, including whitespace and every quoted byte.
+// Token spans correctly distinguish apostrophes within words from quote openers.
+fn condition_key(source: &str) -> Result<String, LanguageError> {
+    let tokens = tokenize::tokenize(source, 0)?;
+    let mut key = String::new();
+    let mut end = 0;
+    for token in tokens {
+        key.push_str(&source[end..token.span.start]);
+        if token.quoted() {
+            key.push_str(token.source());
+        } else {
+            key.push_str(&token.source().to_lowercase());
+        }
+        end = token.span.end;
+    }
+    key.push_str(&source[end..]);
+    Ok(key)
+}
